#!/usr/bin/env bash
# vive - parallel AI agent manager
# A simple CLI to manage multiple Claude agents in tmux windows with git worktrees.

set -euo pipefail

VERSION="3.0.0"

# Get absolute path to the script directory (resolving symlinks)
SOURCE=${BASH_SOURCE[0]}
while [ -L "$SOURCE" ]; do
  DIR=$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )
  SOURCE=$(readlink "$SOURCE")
  [[ $SOURCE != /* ]] && SOURCE=$DIR/$SOURCE
done
SCRIPT_DIR=$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

#######################################
# Helper functions
#######################################

log_info() {
  echo -e "${BLUE}[vive]${NC} $1"
}

log_success() {
  echo -e "${GREEN}[vive]${NC} $1"
}

log_warn() {
  echo -e "${YELLOW}[vive]${NC} $1"
}

log_error() {
  echo -e "${RED}[vive]${NC} $1" >&2
}

get_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || {
    log_error "Not a git repository"
    exit 1
  }
}

get_project_name() {
  basename "$(get_repo_root)"
}

get_main_session_name() {
  get_project_name
}

get_window_name() {
  local issue_id=$1
  echo "issue-${issue_id}"
}

get_worktree_path() {
  local issue_id=$1
  local repo_root=$(get_repo_root)
  echo "${repo_root}/.worktrees/issue-${issue_id}"
}

ensure_session() {
  local session_name=$1
  
  if ! tmux has-session -t "$session_name" 2>/dev/null; then
    log_info "Creating main session: $session_name"
    # Create detached session, initially in repo root
    tmux new-session -d -s "$session_name" -c "$(get_repo_root)"
    
    # Load vive configuration
    if [[ -f "${SCRIPT_DIR}/vive.tmux.conf" ]]; then
      tmux source-file "${SCRIPT_DIR}/vive.tmux.conf"
    fi
    # Ensure mouse is on
    tmux set-option -t "$session_name" mouse on 2>/dev/null || true
  fi
}

attach_session() {
  local session_name=$1
  local window_name=${2:-}
  
  # Select window if specified
  if [[ -n "$window_name" ]]; then
    if tmux list-windows -t "$session_name" -F "#{window_name}" | grep -q "^${window_name}$"; then
      tmux select-window -t "${session_name}:${window_name}"
    fi
  fi
  
  if [[ -n "${TMUX:-}" ]]; then
    # Inside tmux: switch client
    if ! tmux switch-client -t "$session_name" 2>/dev/null; then
      log_error "Failed to switch to session '$session_name'"
      return 1
    fi
  else
    # Outside tmux: attach
    if ! tmux attach -t "$session_name"; then
      log_error "Failed to attach to session '$session_name'"
      return 1
    fi
  fi
}

#######################################
# Commands
#######################################

cmd_start() {
  local issue_id=${1:-}
  local description=${2:-""}
  
  if [[ -z "$issue_id" ]]; then
    log_error "Usage: vive start <issue_id> [description]"
    exit 1
  fi
  
  local repo_root=$(get_repo_root)
  local session_name=$(get_main_session_name)
  local window_name=$(get_window_name "$issue_id")
  local worktree_path=$(get_worktree_path "$issue_id")
  local branch_name="feature/issue-${issue_id}"
  
  if [[ -n "$description" ]]; then
    branch_name="feature/issue-${issue_id}-${description}"
  fi
  
  ensure_session "$session_name"
  
  # Check if window already exists
  if tmux list-windows -t "$session_name" -F "#{window_name}" 2>/dev/null | grep -q "^${window_name}$"; then
    log_warn "Window '$window_name' already exists. Switching..."
    attach_session "$session_name" "$window_name"
    return
  fi
  
  # Create worktree if not exists
  if [[ ! -d "$worktree_path" ]]; then
    log_info "Creating worktree: $worktree_path"
    mkdir -p "$(dirname "$worktree_path")"
    git fetch origin main 2>/dev/null || true
    git worktree add "$worktree_path" -b "$branch_name" origin/main
    
    # Copy .env if exists
    if [[ -f "${repo_root}/.env" ]]; then
      cp "${repo_root}/.env" "${worktree_path}/.env"
      log_info "Copied .env to worktree"
    fi
    
    # Install dependencies
    if [[ -f "${worktree_path}/package.json" ]] || [[ -f "${worktree_path}/web/package.json" ]]; then
      log_info "Installing dependencies..."
      if [[ -f "${worktree_path}/web/package.json" ]]; then
        (cd "${worktree_path}/web" && npm install --silent)
      else
        (cd "${worktree_path}" && npm install --silent)
      fi
    fi
  else
    log_info "Worktree already exists: $worktree_path"
  fi
  
  # Create new window
  log_info "Creating window: $window_name"
  tmux new-window -t "$session_name" -n "$window_name" -c "$worktree_path"
  
  # Send claude command
  tmux send-keys -t "${session_name}:${window_name}" "claude" C-m
  sleep 1
  tmux send-keys -t "${session_name}:${window_name}" "/fix ${issue_id}"
  
  log_success "Window '$window_name' started!"
  attach_session "$session_name" "$window_name"
}

cmd_attach() {
  local issue_id=${1:-}
  local session_name=$(get_main_session_name)
  
  if ! tmux has-session -t "$session_name" 2>/dev/null; then
    log_error "Session '$session_name' not found"
    exit 1
  fi
  
  if [[ -n "$issue_id" ]]; then
    local window_name=$(get_window_name "$issue_id")
    attach_session "$session_name" "$window_name"
  else
    attach_session "$session_name"
  fi
}

cmd_list() {
  local session_name=$(get_main_session_name)
  
  if ! tmux has-session -t "$session_name" 2>/dev/null; then
    log_info "No active session for project '$session_name'"
    return
  fi
  
  log_info "Active windows in session '$session_name':"
  echo ""
  
  tmux list-windows -t "$session_name" -F "#{window_index}: #{window_name} (#{window_active})" | while read -r line; do
    echo -e "  ${GREEN}●${NC} $line"
  done
  echo ""
}

cmd_cleanup() {
  local target=${1:-}
  local session_name=$(get_main_session_name)
  local repo_root=$(get_repo_root)
  
  if [[ "$target" == "all" ]]; then
    log_warn "Cleaning up session and all worktrees..."
    
    # Kill session
    tmux kill-session -t "$session_name" 2>/dev/null || true
    
    # Remove all worktrees
    if [[ -d "${repo_root}/.worktrees" ]]; then
      rm -rf "${repo_root}/.worktrees"
    fi
    git worktree prune
    log_success "Cleanup complete!"
    
  elif [[ -n "$target" ]]; then
    local window_name=$(get_window_name "$target")
    local worktree_path=$(get_worktree_path "$target")
    
    log_info "Cleaning up window: $window_name"
    
    # Kill window
    tmux kill-window -t "${session_name}:${window_name}" 2>/dev/null || true
    
    # Remove worktree
    if [[ -d "$worktree_path" ]]; then
      git worktree remove "$worktree_path" --force 2>/dev/null || rm -rf "$worktree_path"
      log_info "Removed worktree: $worktree_path"
    fi
    git worktree prune
    log_success "Cleanup complete!"
    
  else
    log_error "Usage: vive cleanup <issue_id|all>"
    exit 1
  fi
}

cmd_help() {
  cat << EOF
vive v${VERSION} - parallel AI agent manager (Single Session Mode)

Usage: vive <command> [options]

Commands:
  start <issue> [desc]  Open a new window for an issue
  attach [issue]        Attach to session (optionally switch to issue)
  list                  List active windows
  cleanup <issue|all>   Close window and remove worktree
  help                  Show this help message
  version               Show version

Examples:
  vive start 123              # New window for issue #123
  vive attach 123             # Switch to window #123
  vive cleanup 123            # Close window #123
  vive cleanup all            # Kill entire session

Tmux Shortcuts:
  Ctrl+b c      Create empty window
  Ctrl+b n/p    Next/Previous window
  Ctrl+b w      List windows
  Ctrl+b %      Split pane vertically
  Ctrl+b "      Split pane horizontally
  Ctrl+b Space  Change layout
  Ctrl+b !      Break pane to new window
  Ctrl+b :join-pane -s <window>  Bring window into current pane
EOF
}

cmd_version() {
  echo "vive v${VERSION}"
}

#######################################
# Main
#######################################

main() {
  local command=${1:-help}
  shift || true
  
  case "$command" in
    start)
      cmd_start "$@"
      ;;
    attach|a)
      cmd_attach "$@"
      ;;
    list|ls)
      cmd_list "$@"
      ;;
    cleanup|clean)
      cmd_cleanup "$@"
      ;;
    help|-h|--help)
      cmd_help
      ;;
    version|-v|--version)
      cmd_version
      ;;
    *)
      log_error "Unknown command: $command"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
